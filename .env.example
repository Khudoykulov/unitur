# ============================================================
# Unitur – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# ============================================================

# ── Django ────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

# True for local development, False in production.
DEBUG=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgres://unitur:unitur@localhost:5432/unitur_db

# ── Redis (cache + Celery broker) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Cloudinary (media storage — only used when DEBUG=False) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP — only used when DEBUG=False) ────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Unitur <noreply@unitur.uz>

# ── Sentry (optional error tracking) ─────────────────────────────────────
SENTRY_DSN=

# ── Site info ─────────────────────────────────────────────────────────────
SITE_NAME=UNITUR travel agency
SITE_URL=http://localhost:8000

# ── Hidden admin URL — change to something only you know ────────────────
ADMIN_URL=admin/

# ── Language ──────────────────────────────────────────────────────────────
LANGUAGE_CODE=en

# Auto machine-translate dashboard content into all site languages on save.
AUTO_TRANSLATE=True

# ── Production-only hardening (leave False for local dev) ───────────────
HTTPS_ENABLED=False
SECURE_SSL_REDIRECT=False
